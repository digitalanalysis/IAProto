  "text": [
    "╔══════════════════════════ SALES ORDER MAINTENANCE ═══════════════════════════╗",
    "║ Order No.             Rev      Status     [ ] Online   P.O.                  ║",
    "╟───────────────────────────────────────┬──────────────────────────────────────╢",
    "║ CUSTOMER                              │ DATES                                ║",
    "║ <Customer>                            │ Ordered                              ║",
    "║ Account                               │ Due                                  ║",
    "║ <Sales rep>                           │ Shipped                              ║",
    "║ <Territory>                           │ <Ship via>                           ║",
    "╟───────────────────────────────────────┴──────────────────────────────────────╢",
    "║ ORDER LINES   (click a line to open the product)                             ║",
    "║   Line│ Product│   Qty│    Unit price│ Disc.│     Line total                 ║",
    "║                                                                              ║",
    "║                                                                              ║",
    "║                                                                              ║",
    "║                                                                              ║",
    "║                                                                              ║",
    "║                                                                              ║",
    "╟──────────────────────────────────────────────────────────────────────────────╢",
    "║ <Bill to>                                       Subtotal                     ║",
    "║ <Ship to>                                       Tax                          ║",
    "║ <Card>                Approval                  Freight                      ║",
    "║ <Currency>                                      TOTAL DUE                    ║",
    "║ Comment                                                                      ║",
    "║ F2=Customer  F3=Sales rep  F4=Order lines  F5=Ship via  F10=Exit             ║",
    "╚══════════════════════════════════════════════════════════════════════════════╝"
