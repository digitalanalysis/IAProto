    "┌───────── Gestion du Dossier ─────────────────┬─────────────────┬─────────────┐",
    "│                  du             <Rsq>        │                 │[ ]  Ouvert  │",
    "│<Clétot>         Part             <% Orig.>                                   │",
    "│<Police>                                         [ ] Complexe                 │",
    "│ Clé GIE         Part             Fonds:                       [ ] Connexité  │",
    "│< Type >                                                 < Sous-Dossiers >    │",
    "│< Lieu >                                                                      │",
    "│  Ident.                            <Courtier>       ►Double-cliquez ici      │",
    "│Intitulé                                         ↓                            │",
    "│< Cause >                                        ↓                            │",
    "│< Circonstances > < Garanties... >  Réf. Cédante ↓                            │",
    "│< Evénement... >  < Suivi doss. >                                             │",
    "│                  <      Divers    ><   Co&Ré...  >                           │",
    "│                                                      < + / - >      < Voir > │",
    "│       ...        <     Infos...    >   Réf.↕                                 │",
    "│                                                           Unique             │",
    "├────────────────────────────────────────┬─────────────────────────────────────┤",
    "│Réserve   <Liste >  <Nouvelle> <Estimée>│       <   Dossiers Joints   >       │",
    "│                                        │ [ ] Rés. 100% = 0                   │",
    "├────────────────────────────────────────┤                                     │",
    "│Liste Bons      │<Nouveau dossier>  ≡≡   ?  CAF Tout vérifié     XL           │",
    "│ <B.100> <P.bur>│                  Impr.                                      │",
    "├─────────────────── N° Dossier ───────────────────────────────────────────────┤",
    "│<Recherche... >   ◄   ►    ◄   ►   │< Valider >  │< Annuler >  │<   Quitter  >│",
    "└──────────────────────────────────────────────────────────────────────────────┘"
